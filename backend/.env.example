# ============================================================
# ADEDAS Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# ============================================================
# Database — Neon PostgreSQL
# Get these from: https://console.neon.tech → your project → Connection Details
#
# DATABASE_URL  → pooled endpoint (use for all app queries)
# DIRECT_URL    → direct endpoint (used by Prisma CLI for migrations)
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@ep-ENDPOINT-POOLER.REGION.aws.neon.tech/DBNAME?pgbouncer=true&connect_timeout=10&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require

# ============================================================
# Auth
# ============================================================
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ============================================================
# Paystack — https://dashboard.paystack.com/#/settings/developers
# ============================================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# PayPal — https://developer.paypal.com/dashboard/applications
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ============================================================
# WhatsApp Business API — https://developers.facebook.com/
# ============================================================
WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_PHONE=+2348036262488

# ============================================================
# Frontend
# Update to your Vercel deployment URL before going to production
# ============================================================
FRONTEND_URL=http://localhost:5173
