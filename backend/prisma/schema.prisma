generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id
  name        String
  brand       String   @default("ADEDAS MULTIBUSINESS")
  category    String
  price       Int
  promoPrice  Int?     @map("promo_price")
  volume      String   @default("")
  image       String   @default("/placeholder.svg")
  description String   @default("")
  tags        String[]
  inStock     Boolean  @default(true) @map("in_stock")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("products")
}

model Order {
  id                       String   @id @default(uuid())
  orderNumber              String   @unique @map("order_number")
  customerName             String   @map("customer_name")
  customerEmail            String?  @map("customer_email")
  customerPhone            String   @map("customer_phone")
  deliveryAddress          String   @map("delivery_address")
  paymentMethod            String   @map("payment_method")
  paymentStatus            String   @default("pending") @map("payment_status")
  fulfillmentStatus        String   @default("pending") @map("fulfillment_status")
  subtotal                 Decimal  @db.Decimal(10, 2)
  deliveryFee              Decimal  @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  total                    Decimal  @db.Decimal(10, 2)
  items                    Json     @default("[]")
  paymentReference         String?  @map("payment_reference")
  paystackAuthorizationUrl String?  @map("paystack_authorization_url")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

model Booking {
  id            String   @id @default(uuid())
  bookingNumber String   @unique @map("booking_number")
  customerName  String   @map("customer_name")
  customerEmail String?  @map("customer_email")
  customerPhone String   @map("customer_phone")
  productId     String   @map("product_id")
  productName   String   @map("product_name")
  quantity      Int      @default(1)
  bookingTime   DateTime @default(now()) @map("booking_time")
  status        String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("bookings")
}

model Visit {
  id        String   @id @default(uuid())
  page      String
  timestamp DateTime @default(now())
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  sessionId String   @map("session_id")
  referrer  String?

  @@index([timestamp(sort: Desc)])
  @@index([sessionId])
  @@map("visits")
}

model ActiveUser {
  id        String   @id @default(uuid())
  sessionId String   @unique @map("session_id")
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@index([lastSeen(sort: Desc)])
  @@map("active_users")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}
